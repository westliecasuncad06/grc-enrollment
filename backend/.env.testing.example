APP_NAME="GRC Enrollment API"
APP_ENV=testing
APP_KEY=
APP_DEBUG=false

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grc_enrollment_test
DB_USERNAME=grc_test
DB_PASSWORD=

BCRYPT_ROUNDS=4
# file, not array: PHPUnit overrides this to "array" directly via
# phpunit.xml's <env> block (which takes precedence over this file), so this
# value is unused there. It exists for `php artisan serve --env=testing`,
# used by the E2E suite — PHP's built-in dev server spawns a fresh process
# per request, and the array driver's in-memory state does not survive
# between requests, so the rate limiter (cache-backed) silently never engages
# when served over real HTTP with CACHE_STORE=array.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
