APP_NAME="GRC Enrollment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_APP_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grc_enrollment
DB_USERNAME=grc_app
DB_PASSWORD=

# Least-privileged migration identity (php artisan migrate --database=mariadb_migrator).
# See docs/runbooks/mariadb-local.md for how these principals are created.
DB_MIGRATOR_USERNAME=grc_migrator
DB_MIGRATOR_PASSWORD=

# Bearer token lifetime in minutes. PROVISIONAL — PRD §17 lists the approved
# session/token expiration policy as an open institutional decision. Replace
# with the approved value before any production-like deployment.
SANCTUM_TOKEN_EXPIRATION=480

# Self-service "forgot password" one-time code (minutes) and its wrong-guess
# limit before a new code must be requested.
AUTH_PASSWORD_RESET_CODE_EXPIRE=60
AUTH_PASSWORD_RESET_MAX_ATTEMPTS=5

# Login email OTP (second factor): how long an account's last verified OTP
# keeps future logins from asking again, the wrong-guess limit on a single
# challenge, and how long an unverified challenge itself stays valid.
LOGIN_OTP_GRACE_MINUTES=30
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_CHALLENGE_TTL_MINUTES=10

# Owner-confirmed transitional gap: any account created BEFORE this moment
# is permanently exempt from login OTP — only accounts created from this
# point forward go through it. Temporary rollout allowance, same as the
# password-complexity gap below; revisit/remove before real production
# go-live. Set once at rollout and generally never changed afterward.
LOGIN_OTP_ENFORCED_AFTER="2026-09-29 11:47:46"

# Google Sign-In: the OAuth Client ID from Google Cloud Console (not a
# secret — no client secret is used anywhere in this flow). Leave blank in
# any environment where the Google button should not appear/work.
GOOGLE_CLIENT_ID=

# Super Admin: email address of the sole Super Admin operator. Provisioned exclusively
# via `php artisan super-admin:provision`. Never commit a real value or seed this role.
SUPER_ADMIN_EMAIL=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Private FastAPI prediction service. Browser clients must never call it.
PREDICTION_SERVICE_URL=http://127.0.0.1:8100
PREDICTION_SERVICE_TIMEOUT=30

CACHE_STORE=file
# CACHE_PREFIX=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PRD §17-pending: see config/enrollment.php. Leave ENROLLMENT_GRADE_COMPARISON
# unset (or empty) to make PrerequisiteEvaluator return "needs_verification"
# instead of comparing grades.
ENROLLMENT_GRADE_COMPARISON=lower_is_better
ENROLLMENT_PASSING_GRADE=3.00
ENROLLMENT_FAILING_GRADE=5.00
ENROLLMENT_MAX_REGULAR_UNITS=
ENROLLMENT_OVERLOAD_MAX_UNITS=

# PRD §17-pending: see config/fees.php. The miscellaneous fee list is not
# env-overridable — edit config/fees.php directly to change it.
FEES_CURRENCY=PHP
FEES_TUITION_PER_UNIT=200.00

# Performance (ADR 0029, docs/runbooks/performance-deployment.md).
# Gzip JSON API responses over 1 KB for clients that accept it. Set to false when
# a reverse proxy (nginx, Apache mod_deflate, a CDN) already compresses.
API_COMPRESS_JSON=true
# Local development: LOG_LEVEL=warning keeps laravel.log from ballooning; the
# N+1 guard writes one line per model+relation, but debug logs every query error.
# LAZY_LOADING_VIOLATIONS=throw   # throw (default, fails fast) | log (inventory in one run)
