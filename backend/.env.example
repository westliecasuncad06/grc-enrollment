APP_NAME="GRC Enrollment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grc_enrollment
DB_USERNAME=grc_app
DB_PASSWORD=

# Least-privileged migration identity (php artisan migrate --database=mariadb_migrator).
# See docs/runbooks/mariadb-local.md for how these principals are created.
DB_MIGRATOR_USERNAME=grc_migrator
DB_MIGRATOR_PASSWORD=

# Bearer token lifetime in minutes. PROVISIONAL — PRD §17 lists the approved
# session/token expiration policy as an open institutional decision. Replace
# with the approved value before any production-like deployment.
SANCTUM_TOKEN_EXPIRATION=480

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PRD §17-pending: see config/enrollment.php. Leave ENROLLMENT_GRADE_COMPARISON
# unset (or empty) to make PrerequisiteEvaluator return "needs_verification"
# instead of comparing grades.
ENROLLMENT_GRADE_COMPARISON=lower_is_better
ENROLLMENT_PASSING_GRADE=3.00
ENROLLMENT_FAILING_GRADE=5.00
ENROLLMENT_MAX_REGULAR_UNITS=
ENROLLMENT_OVERLOAD_MAX_UNITS=

# PRD §17-pending: see config/fees.php. The miscellaneous fee list is not
# env-overridable — edit config/fees.php directly to change it.
FEES_CURRENCY=PHP
FEES_TUITION_PER_UNIT=450.00
