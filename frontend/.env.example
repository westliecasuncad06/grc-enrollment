# Public Laravel API origin only. Do not place tokens or credentials here.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Auth mode. Leave unset (or "api") for real Sanctum bearer-token
# authentication against the Laravel backend above — this is the default
# everywhere, including production.
#
# Set to "demo" only for local UI work without a running backend; the
# committed fixtures in docs/testing/DEMO_CREDENTIALS.md become valid
# sign-in credentials. Rejected outside development/test builds.
#
# Set to "disabled" to turn off sign-in entirely.
# VITE_AUTH_MODE=demo
