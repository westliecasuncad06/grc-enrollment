# Public Laravel API origin only. Do not place tokens or credentials here.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Google Sign-In OAuth Client ID from Google Cloud Console. Not a secret —
# it is meant to be visible in the browser and must match the backend's
# GOOGLE_CLIENT_ID exactly. Leave blank to hide the Google sign-in button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
