{
  "name": "grc-enrollment-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fast": "oxlint",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "//overrides": "next@16.2.12 pins postcss 8.4.31 and sharp 0.34.5, both carrying advisories that fail `npm audit --audit-level=moderate` in CI. Both are forced to the patched releases already present elsewhere in the tree. Revisit when a Next release ships them itself. eslint-plugin-jsx-a11y@6.10.2's peerDependencies range tops out at ESLint 9 (stale metadata; ESLint 9->10 was a low-impact major for plugin authors) and it bundles minimatch@3.1.5 -> brace-expansion@1.1.18, which carries a DoS advisory. The eslint override accepts the installed ESLint 10 for peer resolution; the brace-expansion override forces the patched release. Revisit both when jsx-a11y ships an ESLint 10 peer range.",
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "brace-expansion": "^5.0.8"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
